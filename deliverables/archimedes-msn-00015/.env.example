# GitHub REST API origin. HTTPS is required except for loopback test servers.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10

# Authentication mode: auto, none, pat, or app.
GITHUB_AUTH_MODE=auto

# PAT/fine-grained token mode. Use separate credentials when possible.
# GITHUB_READ_TOKEN=
# GITHUB_WRITE_TOKEN=
# GITHUB_TOKEN=  # Fallback used for both read and write when the two values above are absent.

# GitHub App installation mode.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GITHUB_APP_PRIVATE_KEY_BASE64=

# External writes are disabled unless this is explicitly true. Every write tool
# also requires confirm=true in the same MCP call.
GITHUB_ALLOW_WRITES=false

# Bounded network and pagination controls.
GITHUB_TIMEOUT_MS=15000
GITHUB_MAX_RESPONSE_BYTES=5000000
GITHUB_MAX_RETRIES=2
GITHUB_MAX_RETRY_DELAY_MS=5000
GITHUB_MAX_PAGES=5
GITHUB_MAX_FILES=500
GITHUB_USER_AGENT=archimedes-github-pr-mcp/1.0.0
