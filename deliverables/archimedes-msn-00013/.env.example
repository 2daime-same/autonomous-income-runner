# Public API origin. HTTPS is required except for loopback test servers.
ARCHIMEDES_BASE_URL=https://archimedes.market

# Bounded network controls.
ARCHIMEDES_TIMEOUT_MS=15000
ARCHIMEDES_MAX_RESPONSE_BYTES=2000000
ARCHIMEDES_MAX_RETRIES=2

# Optional descriptive user agent. Do not place secrets in this value.
ARCHIMEDES_USER_AGENT=archimedes-market-mcp/1.0.0 (+read-only public API client)
